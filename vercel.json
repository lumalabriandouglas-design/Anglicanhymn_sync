{
  "framework": null,
  "installCommand": "true",
  "buildCommand": "bash tool/vercel-build.sh",
  "outputDirectory": "build/web",
  "ignoreCommand": "test ! -f pubspec.yaml",
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ]
}
